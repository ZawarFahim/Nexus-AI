# Copy this file to `.env` and fill in your values.
# `.env` is git-ignored and must never be committed.

# --- AI providers ----------------------------------------------------------
# Which service Nexus prefers. Supported: groq | cerebras | gemini
NEXUS_LLM_PROVIDER=groq

# Keys for each service. Only one is required. Nexus tries them in preference
# order and moves to the next when a free allowance runs out, so adding a
# second is what keeps it working past the daily limit instead of going quiet
# until tomorrow. See them all with: python -m nexus --providers
#
# Groq      free, no card, ~100k tokens/day, fastest, can see your screen
GROQ_API_KEY=
# Cerebras  free, no card, ~1M tokens/day, text only. Make the key on your
#           Personal account -- a Team one is refused with "payment required"
CEREBRAS_API_KEY=
# Gemini    free with a Google account, counted in requests, can see your screen
GEMINI_API_KEY=

# Model to use. Blank uses the provider's default, which is currently the only
# Groq model that both sees images and calls tools -- Nexus needs both to answer
# questions about your screen. Providers retire models periodically, so this
# exists to switch without editing code.
# Set to llama-3.3-70b-versatile for a larger text-only model; Nexus will then be
# unable to see your screen.
NEXUS_LLM_MODEL=

# --- Optional overrides ----------------------------------------------------
# Leave blank to use sensible defaults.

# Audio device names (substring match). Blank = OS default device.
NEXUS_INPUT_DEVICE=
NEXUS_OUTPUT_DEVICE=

# Keep the microphone stream open so the first word is never clipped.
# Audio sits in a short circular RAM buffer that constantly overwrites itself;
# nothing is stored or sent unless you are holding the hotkey.
# Set to false for stricter privacy: the device stays closed until you press
# the hotkey, at the cost of 100-300ms of startup delay on every interaction.
NEXUS_ALWAYS_ON_MIC=true

# Where speech recognition runs: auto | cpu | cuda
# auto uses the GPU only when both an NVIDIA device and the cuDNN runtime from
# requirements-gpu.txt are present, and otherwise runs on the CPU.
# Force cpu to reproduce what users without a GPU experience.
NEXUS_DEVICE=auto

# Piper voice. See installed ones with: python -m scripts.setup --list
NEXUS_VOICE=en_US-norman-medium

# Let Nexus look at your screen when a question needs it, such as "what does this
# error say". Nothing is captured in the background: a screenshot is taken only
# while answering a question that requires one, and is discarded afterwards.
# Set to false and the capability is never offered to the model at all.
NEXUS_ALLOW_SCREEN=true

# Let Nexus open websites, search the web, and scroll or navigate the page you are
# already on. It never clicks links or buttons, and navigation keys are only
# sent to a browser window that is already in front -- never to your editor or
# terminal.
NEXUS_ALLOW_BROWSER=true

# Float a small animated orb in the corner while Nexus is listening,
# thinking, or speaking. It never takes focus and ignores clicks.
NEXUS_SHOW_ORB=true

# How hard the model thinks before answering: none | default
# Blank uses Nexus's own default, which is "none". Thinking happens before a
# single word is spoken, so on a voice companion it is silence the user sits
# through -- one measured reply spent two hundred words deliberating before
# saying "four". Set to "default" if Nexus starts missing what you meant.
NEXUS_REASONING=

# Speech pace. Above 1.0 is slower, below is faster.
NEXUS_SPEECH_SPEED=1.0

# --- Hands-free mode (Ctrl+Alt+Space) --------------------------------------
# How long a pause ends your turn. Raise it if Nexus cuts you off when you pause
# to think; lower it if Nexus feels slow to answer.
NEXUS_SILENCE_MS=800

# Speech detection sensitivity, 0.0 to 1.0. Raise it in a noisy room; lower it
# if Nexus does not notice you talking.
NEXUS_VAD_THRESHOLD=0.5

# Log verbosity: DEBUG | INFO | WARNING | ERROR
NEXUS_LOG_LEVEL=INFO
