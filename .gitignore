# --- Secrets ---------------------------------------------------------------
.env
*.key
.cache

# --- Virtual environment ---------------------------------------------------
.venv/
venv/

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Models, voices, and vendored binaries (fetched by scripts/setup) ------
models/
voices/
vendor/
*.onnx
*.onnx.json
*.bin

# --- Build artifacts -------------------------------------------------------
build/
dist/
Output/
