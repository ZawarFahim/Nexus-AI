# throwaway .spec files next to whatever it is told to build; those are not.
*.spec
!Nexus.spec

# --- Runtime scratch -------------------------------------------------------
logs/
*.log
recordings/
*.wav

# --- Editors & OS ----------------------------------------------------------
.vscode/
.idea/
Thumbs.db
desktop.ini

# --- Generated at build time ----------------------------------------------
assets/*.ico
